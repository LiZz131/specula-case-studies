+func (cm *ConsensusModule) storedInt(key string, missing int) int {
+	buf, found := cm.storage.Get(key)
+	if !found {
+		return missing
+	}
+	var value int
+	if err := gob.NewDecoder(bytes.NewBuffer(buf)).Decode(&value); err != nil {
+		return missing
+	}
+	return value
+}
+
+func formatIDSet(ids map[int]struct{}) string {
+	if len(ids) == 0 {
+		return "{}"
+	}
+	ordered := make([]int, 0, len(ids))
+	for id := range ids {
+		ordered = append(ordered, id)
+	}
+	sort.Ints(ordered)
+	parts := make([]string, len(ordered))
+	for i, id := range ordered {
+		parts[i] = strconv.Itoa(id)
+	}
+	return "{" + strings.Join(parts, ", ") + "}"
+}
