--- /dev/null
+++ b/filestorage.go	2026-11-03 04:06:34.782665016 +0000
@@ -0,0 +1,65 @@
+package raft
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+)
+
+// FileStorage is the durable Storage used by controlled replay.
+// Set writes a file and renames it into place. Get reads that file.
+// A new ConsensusModule must load this directory; it must not be handed
+// the previous module's memory.
+type FileStorage struct {
+	dir string
+	mu  sync.Mutex
+}
+
+func NewFileStorage(dir string) *FileStorage {
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		panic(err)
+	}
+	return &FileStorage{dir: dir}
+}
+
+func (fs *FileStorage) path(key string) string {
+	return filepath.Join(fs.dir, key)
+}
+
+func (fs *FileStorage) Set(key string, value []byte) {
+	fs.mu.Lock()
+	defer fs.mu.Unlock()
+	tmp := fs.path(key) + ".tmp"
+	if err := os.WriteFile(tmp, value, 0o644); err != nil {
+		panic(err)
+	}
+	if err := os.Rename(tmp, fs.path(key)); err != nil {
+		panic(err)
+	}
+}
+
+func (fs *FileStorage) Get(key string) ([]byte, bool) {
+	fs.mu.Lock()
+	defer fs.mu.Unlock()
+	buf, err := os.ReadFile(fs.path(key))
+	if err != nil {
+		return nil, false
+	}
+	return buf, true
+}
+
+func (fs *FileStorage) HasData() bool {
+	fs.mu.Lock()
+	defer fs.mu.Unlock()
+	entries, err := os.ReadDir(fs.dir)
+	if err != nil {
+		return false
+	}
+	for _, entry := range entries {
+		if !strings.HasSuffix(entry.Name(), ".tmp") {
+			return true
+		}
+	}
+	return false
+}
