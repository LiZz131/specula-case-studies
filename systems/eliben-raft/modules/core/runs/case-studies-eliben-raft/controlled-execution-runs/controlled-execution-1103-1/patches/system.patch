+
+func (cm *ConsensusModule) ControlledAdvanceCommit() {
+	cm.mu.Lock()
+	defer cm.mu.Unlock()
+	if cm.state != Leader {
+		return
+	}
+	for i := cm.commitIndex + 1; i < len(cm.log); i++ {
+		if cm.log[i].Term != cm.currentTerm {
+			continue
+		}
+		matchCount := 1
+		for _, id := range cm.peerIds {
+			if cm.matchIndex[id] >= i {
+				matchCount++
+			}
+		}
+		if matchCount*2 > len(cm.peerIds)+1 {
+			cm.commitIndex = i
+		}
+	}
+}
+
+func (cm *ConsensusModule) ControlledPersistTermOnly() {
+	cm.mu.Lock()
+	defer cm.mu.Unlock()
+	cm.writeCurrentTerm()
+}
