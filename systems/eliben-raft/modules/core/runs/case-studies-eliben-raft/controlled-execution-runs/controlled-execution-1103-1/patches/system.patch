+func (cm *ConsensusModule) ControlledSendAE(peer int) []OutMsg {
+	cm.mu.Lock()
+	defer cm.mu.Unlock()
+	if cm.state != Leader || peer == cm.id {
+		return nil
+	}
+	ni := cm.nextIndex[peer]
+	prevLogIndex := ni - 1
+	prevLogTerm := -1
+	var entries []LogEntry
+	if prevLogIndex >= 0 && prevLogIndex < len(cm.log) {
+		prevLogTerm = cm.log[prevLogIndex].Term
+	}
+	if ni >= 0 && ni < len(cm.log) {
+		entries = append([]LogEntry(nil), cm.log[ni:]...)
+	}
+	args := AppendEntriesArgs{
+		Term:         cm.currentTerm,
+		LeaderId:     cm.id,
+		PrevLogIndex: prevLogIndex,
+		PrevLogTerm:  prevLogTerm,
+		Entries:      entries,
+		LeaderCommit: cm.commitIndex,
+	}
+	return []OutMsg{{Peer: peer, Data: encodeAE(args)}}
+}
+
+func (cm *ConsensusModule) ControlledBecomeLeader() {
