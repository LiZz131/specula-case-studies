@@ -0,0 +1,450 @@
+#!/usr/bin/env python3
+"""Sample and replay eliben/raft controlled execution.
+
+Coverage is go tool cover statement counts, not gcov. Go has no branch
+counters, so branch_taken_pct stays null. A variable mismatch or a
+protocol deviation is recorded and the walk continues. An adapter failure
+or a plan-outside crash stops the walk.
+"""
+
+import argparse
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import time
+from concurrent.futures import ThreadPoolExecutor, as_completed
+from pathlib import Path
+
+CE = Path("/users/bingzhuo/Specula/case-studies/systems/eliben-raft/modules/core/runs/case-studies-eliben-raft/controlled-execution-runs/controlled-execution-1102-1")
+RUN = CE.parent.parent
+SPEC = CE / "spec"
+MOUNT = Path("/users/bingzhuo/sandtable/build/mount/specula-eliben")
+CONTAINER = "/root/sandtable/specula-eliben"
+JAR = "/users/bingzhuo/sandtable/scripts/tla2tools.jar"
+SCRIPT = CONTAINER + "/sandtable/systems/ElibenRaft/scripts/run_one_testcase.sh"
+
+CONFIGS = [
+    ("standard", "MC_for_sandtable.cfg"),
+    ("f1a", "MC_for_sandtable_f1a.cfg"),
+    ("f1b", "MC_for_sandtable_f1b.cfg"),
+    ("f1c", "MC_for_sandtable_f1c.cfg"),
+    ("f2a", "MC_for_sandtable_f2a.cfg"),
+]
+SOURCE_FILES = ("raft.go", "server.go", "storage.go", "controlled.go", "filestorage.go")
+SYSTEM = CE / "system"
+
+
+def run(cmd, timeout=180):
+    return subprocess.run(cmd, text=True, capture_output=True, timeout=timeout)
+
+
+def trace_name(seed):
+    return "t%04d" % seed
+
+
+def trace_dir(config, seed):
+    return CE / config / "traces" / trace_name(seed)
+
+
+def sample_one(config, cfg, seed):
+    dest = trace_dir(config, seed)
+    dest.mkdir(parents=True, exist_ok=True)
+    out = dest / "MC.out"
+    if out.is_file() and "pc |->" in out.read_text(errors="replace"):
+        return config, seed, "skip"
+    meta = "/tmp/tlc-eliben-%s-%d" % (config, seed)
+    shutil.rmtree(meta, ignore_errors=True)
+    cmd = [
+        "java", "-Xmx512m", "-jar", JAR, "-tool", "-workers", "1", "-simulate",
+        "-depth", "50", "-seed", str(seed), "-metadir", meta,
+        "-config", str(SPEC / cfg), "MC_for_sandtable",
+    ]
+    result = subprocess.run(cmd, cwd=SPEC, text=True, capture_output=True, timeout=180)
+    shutil.rmtree(meta, ignore_errors=True)
+    text = result.stdout
+    if "pc |->" not in text:
+        (dest / "tlc.err").write_text((result.stdout or "")[-4000:] + "\n" + (result.stderr or "")[-2000:])
+        (dest / "tlc.status").write_text("exit %d\n" % result.returncode)
+        return config, seed, "tlc-fail"
+    out.write_text(text)
+    violated = re.findall(r"Invariant (\S+) is violated", text)
+    (dest / "tlc.status").write_text("exit %d\n%s\n" % (result.returncode, "\n".join(violated)))
+    return config, seed, "ok"
+
+
+def sample(configs, seeds, jobs):
+    tasks = [(name, cfg, seed) for name, cfg in CONFIGS if name in configs for seed in seeds]
+    with ThreadPoolExecutor(max_workers=jobs) as pool:
+        futures = [pool.submit(sample_one, name, cfg, seed) for name, cfg, seed in tasks]
+        for future in as_completed(futures):
+            name, seed, status = future.result()
+            print("sample %s %s %s" % (name, trace_name(seed), status), flush=True)
+
+
+def sync_mount():
+    MOUNT.mkdir(parents=True, exist_ok=True)
+    subprocess.check_call(["rsync", "-a", "--delete", "--exclude", "driver/build", str(CE / "sandtable") + "/", str(MOUNT / "sandtable") + "/"])
+    subprocess.check_call(["rsync", "-a", str(SYSTEM) + "/", str(MOUNT / "system") + "/"])
+    so = CE / "sandtable/systems/ElibenRaft/driver/libeliben.so"
+    build = MOUNT / "sandtable/systems/ElibenRaft/driver/build"
+    if so.is_file() and build.is_dir():
+        subprocess.check_call(["sudo", "cp", "-f", str(so), str(build / "libeliben.so")])
+
+
+def clear_cover():
+    for node in ("n1", "n2", "n3"):
+        run(["sudo", "docker", "exec", node, "rm", "-rf", "/tmp/gocov-%s" % node])
+
+
+def replay_one(config, seed):
+    src = trace_dir(config, seed) / "MC.out"
+    host_work = MOUNT / "work" / config / trace_name(seed)
+    run(["sudo", "rm", "-rf", str(host_work)])
+    host_work.mkdir(parents=True)
+    shutil.copy(src, host_work / "MC.out")
+    container_mc = "%s/work/%s/%s/MC.out" % (CONTAINER, config, trace_name(seed))
+    started = time.monotonic()
+    try:
+        result = run(["sudo", "docker", "exec", "controller", "bash", SCRIPT, container_mc, "3"], timeout=180)
+        elapsed = time.monotonic() - started
+        code = result.returncode
+        extra = (result.stdout or "")[-1500:] + "\n" + (result.stderr or "")[-1500:]
+    except subprocess.TimeoutExpired:
+        elapsed = time.monotonic() - started
+        code = 124
+        extra = "timeout"
+    dest = trace_dir(config, seed)
+    test = host_work / "test"
+    for name in ("traces.txt", "log.host"):
+        found = test / name
+        if found.is_file():
+            subprocess.check_call(["sudo", "cp", str(found), str(dest / name)])
+            subprocess.check_call(["sudo", "chown", "%d:%d" % (os.getuid(), os.getgid()), str(dest / name)])
+    for index in (1, 2, 3):
+        found = test / ("log.%d" % index)
+        if found.is_file():
+            target = dest / ("n%d.log" % index)
+            subprocess.check_call(["sudo", "cp", str(found), str(target)])
+            subprocess.check_call(["sudo", "chown", "%d:%d" % (os.getuid(), os.getgid()), str(target)])
+    cover_dir = dest / "cover"
+    if cover_dir.exists():
+        subprocess.check_call(["sudo", "rm", "-rf", str(cover_dir)])
+    cover_dir.mkdir()
+    for node in ("n1", "n2", "n3"):
+        copied = run(["sudo", "docker", "cp", "%s:/tmp/gocov-%s" % (node, node), str(cover_dir / node)])
+        if copied.returncode != 0:
+            extra += "\ndocker cp %s failed" % node
+    run(["sudo", "chmod", "-R", "a+rX", str(cover_dir)])
+    (dest / "replay.status").write_text("exit %s\n%s\n" % (code, extra))
+    run(["sudo", "rm", "-rf", str(host_work)])
+    return elapsed, code
+
+
+def step_pc(text, variable_at):
+    matches = list(re.finditer(r"# \[(\d+)\][^\n]*", text[:variable_at]))
+    if not matches:
+        return ""
+    line = matches[-1].group(0)
+    return re.sub(r"\s+", " ", line).strip()
+
+
+def node_logs(config, seed):
+    parts = []
+    for index in (1, 2, 3):
+        path = trace_dir(config, seed) / ("n%d.log" % index)
+        if path.is_file():
+            parts.append(path.read_text(errors="replace"))
+    return "\n".join(parts)
+
+
+def judge(config, seed, exit_code):
+    path = trace_dir(config, seed) / "log.host"
+    if not path.is_file():
+        return {"ok": False, "logout": False, "kind": "crash", "variable": "",
+                "code_value": "", "model_value": "", "detail": "no log.host", "pc": ""}
+    text = path.read_text(errors="replace")
+    nodes = node_logs(config, seed)
+    fatal = re.search(r"(?m)^.*(?:not found in storage|panic:|fatal error:).*$", nodes)
+    variable = re.search(r'Variable "([^"]+)" compare failed', text)
+    logout = "logout" in text
+    sanitizer = ("Sanitizer" in text) or ("stack smashing" in text)
+    lib_assert = bool(re.search(r"(?m)^(?!.*Command\.cpp).*(Assertion|panic:)", text))
+    code_value = model_value = ""
+    pc = ""
+    # Torn storage: restoreFromStorage fatals. MCPartialPersist instead
+    # recovers a live follower. Confirmed on standard t0007.
+    if fatal and "not found in storage" in fatal.group(0):
+        pc = step_pc(text, len(text))
+        return {
+            "ok": False, "logout": logout, "kind": "spec",
+            "variable": "restore",
+            "code_value": fatal.group(0).strip(),
+            "model_value": "MCPartialPersist recovers a live follower",
+            "detail": fatal.group(0).strip(), "pc": pc,
+        }
+    if variable:
+        window = text[variable.start():variable.start() + 500]
+        code_m = re.search(r"Code \(([^)]*)\): (.*)", window)
+        model_m = re.search(r"Model\(([^)]*)\): (.*)", window)
+        if code_m:
+            code_value = code_m.group(0).strip()
+        if model_m:
+            model_value = model_m.group(0).strip()
+        pc = step_pc(text, variable.start())
+        if code_m and code_m.group(2).strip() == "":
+            kind, ok, detail = "environment", False, "empty code value"
+        else:
+            kind, ok, detail = "pending", False, variable.group(0)
+    elif fatal or sanitizer or lib_assert or exit_code not in (0, None) or not logout:
+        pc = step_pc(text, len(text))
+        kind, ok = "crash", False
+        if fatal:
+            detail = fatal.group(0).strip()
+        elif sanitizer:
+            detail = "sanitizer"
+        elif lib_assert:
+            detail = "assert"
+        else:
+            detail = "exit %s logout=%s" % (exit_code, logout)
+    else:
+        kind, ok, detail = "pass", True, ""
+    return {
+        "ok": ok, "logout": logout, "kind": kind,
+        "variable": variable.group(1) if variable else "",
+        "code_value": code_value, "model_value": model_value,
+        "detail": detail, "pc": pc,
+    }
+
+
+def append_failure(config, seed, exit_code, verdict, klass):
+    path = CE / "failures.tsv"
+    if not path.is_file():
+        path.write_text("配置\t轨迹\t种子\t归类\t退出码\tlogout\t变量\t代码值\t模型值\tpc\t记录目录\n")
+    row = "\t".join([
+        config, trace_name(seed), str(seed), klass, str(exit_code),
+        "yes" if verdict["logout"] else "no",
+        verdict["variable"],
+        verdict["code_value"].replace("\t", " ").replace("\n", " "),
+        verdict["model_value"].replace("\t", " ").replace("\n", " "),
+        verdict["pc"],
+        str(trace_dir(config, seed).relative_to(RUN)),
+    ])
+    with path.open("a") as handle:
+        handle.write(row + "\n")
+
+
+def parse_cover_dir(path):
+    blocks = {}
+    if not path.is_dir():
+        return blocks
+    for tsv in path.rglob("cover.*.tsv"):
+        for line in tsv.read_text(errors="replace").splitlines():
+            parts = line.split("\t")
+            if len(parts) != 5:
+                continue
+            file, start, end, stmts, count = parts
+            key = (file, int(start), int(end), int(stmts))
+            blocks[key] = blocks.get(key, 0) + int(count)
+    return blocks
+
+
+def merge_blocks(accum, extra):
+    for key, count in extra.items():
+        accum[key] = accum.get(key, 0) + count
+
+
+def line_map(blocks):
+    lines = {}
+    for (file, start, end, _stmts), count in blocks.items():
+        source = Path(file).name
+        lo, hi = (start, end) if start <= end else (end, start)
+        for number in range(lo, hi + 1):
+            key = (source, number)
+            lines[key] = max(lines.get(key, 0), count)
+    return lines
+
+
+def line_pct(blocks):
+    lines = line_map(blocks)
+    if not lines:
+        return 0.0
+    hit = sum(1 for count in lines.values() if count > 0)
+    return 100.0 * hit / len(lines)
+
+
+def write_gcov(config, blocks):
+    gcov_dir = CE / config / "gcov"
+    if gcov_dir.exists():
+        shutil.rmtree(gcov_dir)
+    gcov_dir.mkdir(parents=True)
+    lines = line_map(blocks)
+    by_file = {}
+    for (source, number), count in lines.items():
+        by_file.setdefault(source, {})[number] = count
+    for source, rows in by_file.items():
+        text = ["        -:    0:Source:%s" % (SYSTEM / source)]
+        for number in sorted(rows):
+            count = rows[number]
+            mark = "#####" if count == 0 else "%8d" % min(count, 99999999)
+            text.append("%s:%5d:" % (mark, number))
+        (gcov_dir / (source + ".gcov")).write_text("\n".join(text) + "\n")
+
+
+def load_coverage(config):
+    path = CE / config / "coverage.json"
+    if not path.is_file():
+        return {"config": config, "traces": []}
+    return json.loads(path.read_text())
+
+
+def save_coverage(config, doc):
+    traces = doc["traces"]
+    pcts = [item["line_pct"] for item in traces]
+    last_rise = 0
+    for index, pct in enumerate(pcts, start=1):
+        if index == 1 or pct > pcts[index - 2] + 1e-9:
+            last_rise = index
+    wall = [item["replay_s"] for item in traces]
+    doc["summary"] = {
+        "traces": len(traces),
+        "variable_ok": sum(1 for item in traces if item["ok"]),
+        "line_pct": pcts[-1] if pcts else 0,
+        "branch_taken_pct": None,
+        "branch_note": "Go cover counts statements and has no branch counters",
+        "plateau_trace": trace_name(traces[last_rise - 1]["seed"]) if traces and last_rise else "",
+        "plateaued": bool(pcts) and last_rise < len(pcts),
+        "wall_s": round(sum(wall), 1) if wall else 0,
+        "wall_avg": round(sum(wall) / len(wall), 2) if wall else 0,
+        "wall_min": round(min(wall), 2) if wall else 0,
+        "wall_max": round(max(wall), 2) if wall else 0,
+    }
+    (CE / config / "coverage.json").write_text(json.dumps(doc, indent=2) + "\n")
+
+
+def replay(configs, seeds):
+    stopped = False
+    for name, _cfg in CONFIGS:
+        if name not in configs or stopped:
+            continue
+        doc = load_coverage(name)
+        have = {item["trace"] for item in doc["traces"]}
+        accum = {}
+        for item in doc["traces"]:
+            merge_blocks(accum, parse_cover_dir(CE / name / "traces" / item["trace"] / "cover"))
+        for seed in seeds:
+            label = trace_name(seed)
+            if label in have:
+                continue
+            if not (trace_dir(name, seed) / "MC.out").is_file():
+                print("skip %s %s no MC.out" % (name, label), flush=True)
+                continue
+            print("replay %s %s" % (name, label), flush=True)
+            clear_cover()
+            elapsed, code = replay_one(name, seed)
+            verdict = judge(name, seed, code)
+            if verdict["kind"] == "environment":
+                print("  retry %s %s" % (name, label), flush=True)
+                clear_cover()
+                elapsed, code = replay_one(name, seed)
+                verdict = judge(name, seed, code)
+            fresh = parse_cover_dir(trace_dir(name, seed) / "cover")
+            merge_blocks(accum, fresh)
+            doc["traces"].append({
+                "trace": label,
+                "seed": seed,
+                "replay_s": round(elapsed, 3),
+                "ok": verdict["ok"],
+                "logout": verdict["logout"],
+                "kind": verdict["kind"],
+                "variable": verdict["variable"],
+                "detail": verdict["detail"],
+                "pc": verdict["pc"],
+                "line_pct": round(line_pct(accum), 4),
+                "branch_taken_pct": None,
+            })
+            save_coverage(name, doc)
+            write_gcov(name, accum)
+            print("  ok=%s kind=%s line=%.2f %.1fs %s %s" % (
+                verdict["ok"], verdict["kind"], line_pct(accum), elapsed, verdict["pc"], verdict["detail"]), flush=True)
+            if verdict["kind"] in ("pending", "spec", "bug"):
+                append_failure(name, seed, code, verdict, verdict["kind"])
+            if verdict["kind"] in ("crash", "environment", "adapter"):
+                append_failure(name, seed, code, verdict, verdict["kind"])
+                print("STOP %s %s %s" % (name, label, verdict["kind"]), flush=True)
+                stopped = True
+                break
+        save_coverage(name, doc)
+        write_gcov(name, accum)
+    return stopped
+
+
+def write_union(configs):
+    merged = {}
+    for name in configs:
+        blocks = {}
+        gcov_dir = CE / name / "gcov"
+        if not gcov_dir.is_dir():
+            continue
+        for path in gcov_dir.glob("*.gcov"):
+            source = path.name[:-5]
+            for line in path.read_text(errors="replace").splitlines():
+                match = re.match(r"\s*(#####|\d+):\s*(\d+):", line)
+                if not match or match.group(2) == "0":
+                    continue
+                count = 0 if match.group(1) == "#####" else int(match.group(1))
+                key = (source, int(match.group(2)))
+                blocks[key] = count
+        for key, count in blocks.items():
+            merged[key] = max(merged.get(key, 0), count)
+    records = []
+    for source in SOURCE_FILES:
+        rows = [(number, count) for (src, number), count in sorted(merged.items()) if src == source]
+        if not rows:
+            continue
+        body = ["SF:%s" % (SYSTEM / source)]
+        for number, count in rows:
+            body.append("DA:%d,%d" % (number, count))
+        hit = sum(1 for _, count in rows if count > 0)
+        body.append("LH:%d" % hit)
+        body.append("LF:%d" % len(rows))
+        body.append("end_of_record")
+        records.append("\n".join(body))
+    (CE / "lcov.info").write_text("\n".join(records) + "\n")
+    uncovered = ["%s:%d" % (source, number) for (source, number), count in sorted(merged.items()) if count == 0]
+    (CE / "uncovered.txt").write_text("\n".join(uncovered) + ("\n" if uncovered else ""))
+    hit = sum(1 for count in merged.values() if count > 0)
+    print("union lines %d hit %d uncovered %d" % (len(merged), hit, len(uncovered)), flush=True)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--phase", choices=("sample", "replay", "uncovered", "all"), default="all")
+    parser.add_argument("--configs", default=",".join(name for name, _ in CONFIGS))
+    parser.add_argument("--seed-from", type=int, default=1)
+    parser.add_argument("--count", type=int, default=100)
+    parser.add_argument("--jobs", type=int, default=4)
+    args = parser.parse_args()
+    if args.configs == "all":
+        configs = [name for name, _cfg in CONFIGS]
+    else:
+        configs = [item for item in args.configs.split(",") if item]
+    seeds = list(range(args.seed_from, args.seed_from + args.count))
+    CE.mkdir(parents=True, exist_ok=True)
+    if args.phase in ("sample", "all"):
+        sample(configs, seeds, args.jobs)
+    if args.phase in ("replay", "all"):
+        sync_mount()
+        stopped = replay(configs, seeds)
+        if stopped:
+            print("REPLAY_STOPPED", flush=True)
+            return
+    if args.phase in ("uncovered", "all"):
+        write_union([name for name, _ in CONFIGS if name in configs])
+    print("ROUND_DONE", flush=True)
+
+
+if __name__ == "__main__":
+    main()
