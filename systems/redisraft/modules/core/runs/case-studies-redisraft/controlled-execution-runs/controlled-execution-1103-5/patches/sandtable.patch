+#!/bin/bash
+# Merge the three nodes' gcda inside the controller and emit gcov for the library.
+set -euo pipefail
+BASE=/root/sandtable/specula-redisraft/sandtable/systems/WRaft-series/driver/build/CMakeFiles/RedisRaftDriver.dir
+SRC=root/sandtable/specula-redisraft/system/src
+OUT=/root/sandtable/specula-redisraft/gcov-out
+rm -rf /tmp/rr-gcov-a /tmp/rr-gcov "$OUT"
+mkdir -p "$OUT"
+gcov-tool merge -o /tmp/rr-gcov-a /tmp/gcov-n1 /tmp/gcov-n2
+gcov-tool merge -o /tmp/rr-gcov /tmp/rr-gcov-a /tmp/gcov-n3
+cd "$OUT"
+shopt -s nullglob
+found=0
+for g in "$BASE/$SRC"/*.gcno; do
+    name=$(basename "$g" .gcno)
+    cp "/tmp/rr-gcov/$BASE/$SRC/$name.gcda" .
+    cp "$g" .
+    found=1
+done
+if [[ "$found" -ne 1 ]]; then
+    echo "no library gcno under $BASE/$SRC" >&2
+    find "$BASE" -name '*.gcno' | head
+    exit 1
+fi
+gcov -b ./*.gcno > "$OUT/summary.txt"
