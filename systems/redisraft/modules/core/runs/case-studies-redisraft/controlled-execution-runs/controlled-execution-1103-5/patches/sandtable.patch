+import os
+import sys
+import argparse
+
+NODES = {"s1": "n1", "s2": "n2", "s3": "n3"}
+ORDER = ["s1", "s2", "s3"]
+STATE = {"Follower": "1", "Candidate": "3", "Leader": "4"}
+TYPES = {"ValueEntry": "Value", "ConfigEntry": "Config", "NoopEntry": "Noop"}
+PER_NODE = (
+    "currentTerm", "votedFor", "log", "logOffset", "state", "commitIndex",
+    "nextIndex", "matchIndex", "votesGranted", "snapshotLastIdx", "snapshotLastTerm",
+    "loadingSnapshot", "pendingSnapshotIdx", "pendingSnapshotTerm",
+    "clusterConfig", "votingCfgChangeIdx",
+)
+
+
+def set_path():
+    script_dir = os.path.dirname(os.path.realpath(__file__))
+    deps = script_dir
+    for _ in range(4):
+        deps = os.path.dirname(deps)
+    sys.path.append(os.path.join(deps, "scripts"))
+
+
+set_path()
+from trace_reader import TraceReader
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description="redisraft controlled-execution generator")
+    parser.add_argument("trace_file")
+    parser.add_argument("-c", dest="config", required=True)
+    parser.add_argument("-o", dest="output", default="traces.txt")
+    parser.add_argument("-f", dest="conn_fd", default="126")
+    parser.add_argument("-n", dest="node_port", default="9000")
+    parser.add_argument("-d", dest="debug", action="store_true")
+    parser.add_argument("-i", dest="in_place", action="store_true")
+    parser.add_argument("-I", dest="in_dir", default="")
+    args = parser.parse_args()
+    if not args.in_place:
+        args.trace_file = os.path.realpath(args.trace_file)
+        args.config = os.path.realpath(args.config)
+        directory = os.path.dirname(args.trace_file)
+        if args.in_dir:
+            directory = os.path.join(directory, args.in_dir)
+            os.makedirs(directory, mode=0o755, exist_ok=True)
+        os.chdir(directory)
+        case_dir = os.path.basename(args.trace_file) + ".dir"
+        os.makedirs(case_dir, mode=0o755, exist_ok=True)
+        os.chdir(case_dir)
+    return args
+
+
+def node(name):
+    if name not in NODES:
+        raise SystemExit("unknown server %s" % name)
+    return NODES[name]
+
+
+def text_of(value):
+    if isinstance(value, (list, tuple, set, frozenset)):
+        return ",".join(text_of(item) for item in value)
+    return str(value)
+
+
+def fmt_config(cfg):
+    if not cfg:
+        return "{}"
+    names = sorted(node(item) for item in cfg)
+    return "{" + ",".join(names) + "}"
+
+
+def fmt_log(entries):
+    parts = []
+    for entry in entries:
+        parts.append("(%s, %s, %s)" % (entry["term"], TYPES[entry["type"]], fmt_config(entry["config"])))
+    return "[" + ", ".join(parts) + "]"
+
+
+def fmt_votes(names):
+    return "{" + ",".join(node(name) for name in sorted(names)) + "}"
+
+
+def fmt_index(values):
+    parts = ["'%s': %s" % (node(name), values[name]) for name in sorted(values)]
+    return "{" + ", ".join(parts) + "}"
+
+
+def model_value(name, value):
+    if name == "log":
+        return fmt_log(value)
+    if name == "state":
+        return STATE[value]
+    if name == "votedFor":
+        return "Nil" if value == "Nil" else node(value)
+    if name in ("votesGranted", "clusterConfig"):
+        return fmt_votes(value)
+    if name in ("nextIndex", "matchIndex"):
+        return fmt_index(value)
+    if isinstance(value, bool):
+        return "TRUE" if value else "FALSE"
+    return str(value)
+
+
+def net_len(messages):
+    if isinstance(messages, dict):
+        return sum(messages.values())
+    return len(messages)
+
+
+def compare_all(state):
+    for server in ORDER:
+        impl = node(server)
+        for name in PER_NODE:
+            yield ["execute", impl, "get " + name]
+            yield ["#", "variable", name, server, model_value(name, state[name][server])]
+            yield ["compare", "variable"]
+    for name in ("staleReadDetected", "noopReadDetected"):
+        yield ["execute", "n1", "get " + name]
+        yield ["#", "variable", name, "s1", model_value(name, state[name])]
+        yield ["compare", "variable"]
+    yield ["#", "net-len", str(net_len(state["messages"]))]
+    yield ["compare", "net-len"]
+    yield ["status"]
+
+
+class SeqMap:
+    def __init__(self):
+        self.offset = 0
+        self.slots = {}
+
+    def note_sends(self, before, after):
+        for seq in range(before + 1, after + 1):
+            self.slots[seq] = [seq + self.offset]
+
+    def take(self, seq):
+        slots = self.slots.get(int(seq)) or []
+        if not slots:
+            raise SystemExit("seq %s has no copy left" % (seq,))
+        return slots.pop(0)
+
+    def on_lose(self, seq):
+        slots = self.slots.get(int(seq)) or []
+        if not slots:
+            raise SystemExit("seq %s has no copy left" % (seq,))
+        return slots.pop()
+
+
+def deliver(src, dst, seq):
+    yield ["deliver-unordered", node(src), node(dst), str(seq)]
+    yield ["loop", "intercept", node(dst), "check_has_recv_queue", node(src)]
+    yield ["execute", node(dst), "raft recvfrom " + node(src)]
+
+
+def commands(pc, seqmap):
+    kind = pc[0]
+    if kind == "Init":
+        yield ["init", "3"]
+        for impl in ("n1", "n2", "n3"):
+            yield ["execute", impl, "net connectall"]
+            yield ["execute", impl, "raft init"]
+        yield ["wait-init", "3"]
+        for impl in ("n1", "n2", "n3"):
+            yield ["loop", "execute", impl, "net isallconnected"]
+        return
+    if kind == "Timeout":
+        yield ["intercept", node(pc[1]), "inc_time_ms", "2000"]
+        yield ["execute", node(pc[1]), "raft timeout"]
+        return
+    if kind in ("HandleRequestVoteRequest", "HandleRequestVoteResponse",
+                "HandleAppendEntriesRequest", "HandleAppendEntriesResponse",
+                "HandleInstallSnapshotRequest"):
+        yield from deliver(pc[2], pc[1], seqmap.take(pc[3]))
+        return
+    if kind in ("LoseMessage", "DropStaleMessage"):
+        yield ["drop-unordered", node(pc[1]), node(pc[2]), str(seqmap.on_lose(pc[3]))]
+        return
+    if kind == "ClientRequest":
+        yield ["execute", node(pc[1]), "raft cli"]
+        return
+    if kind == "AppendEntries":
+        yield ["execute", node(pc[1]), "raft send " + node(pc[2])]
+        return
+    if kind == "SendInstallSnapshot":
+        yield ["execute", node(pc[1]), "raft snap-send " + node(pc[2])]
+        return
+    if kind == "TakeSnapshot":
+        yield ["execute", node(pc[1]), "raft snapshot"]
+        return
+    if kind == "EndLoadSnapshot":
+        yield ["execute", node(pc[1]), "raft end-load"]
+        return
+    if kind == "BecomeLeader":
+        yield ["execute", node(pc[1]), "raft become-leader"]
+        return
+    if kind == "AdvanceCommitIndex":
+        yield ["execute", node(pc[1]), "raft advance-commit"]
+        return
+    if kind == "ClientNonQuorumRead":
+        yield ["execute", node(pc[1]), "raft read"]
+        return
+    if kind == "ProposeAddServer":
+        yield ["execute", node(pc[1]), "raft add " + node(pc[2])]
+        return
+    if kind == "ProposeRemoveServer":
+        yield ["execute", node(pc[1]), "raft remove " + node(pc[2])]
+        return
+    if kind == "Crash":
+        yield ["execute", node(pc[1]), "raft crash"]
+        return
+    raise SystemExit("unknown pc %s" % (pc,))
+
+
+def yield_trace(states):
+    if not states or "scr" not in states[0]:
+        raise SystemExit("trace has no scr")
+    seqmap = SeqMap()
+    previous = 0
+    for index, state in enumerate(states, start=1):
+        pc = state["scr"]["pc"]
+        n_sent = state["scr"]["nSent"]
+        seqmap.note_sends(previous, n_sent)
+        yield ["#", "[%d]" % index] + [text_of(item) for item in pc]
+        yield from commands(pc, seqmap)
+        yield from compare_all(state)
+        previous = n_sent
+    for impl in ("n1", "n2", "n3"):
+        yield ["execute", impl, "raft statemachine"]
+
+
+def main():
+    args = parse_args()
+    try:
+        os.symlink(args.config, "config.txt")
+    except FileExistsError:
+        pass
+    try:
+        os.symlink(args.trace_file, "tlc_trace.txt")
+    except FileExistsError:
+        pass
+    states = list(TraceReader(True).trace_reader(args.trace_file))
+    lines = [" ".join(str(item) for item in command) for command in yield_trace(states)]
+    with open(args.output, "w") as handle:
+        handle.write("\n".join(lines) + "\n")
+
+
+if __name__ == "__main__":
+    main()
