+#!/usr/bin/env python3
+"""Sample and replay the redis-raft controlled-execution round.
+
+Records stay in the round directory. The mount is only the working copy.
+"""
+
+import argparse
+import ast
+import json
+import os
+import re
+import shutil
+import subprocess
+import time
+from concurrent.futures import ThreadPoolExecutor, as_completed
+from pathlib import Path
+
+CE = Path("/users/bingzhuo/Specula/case-studies/systems/redisraft/modules/core/runs/case-studies-redisraft/controlled-execution-runs/controlled-execution-1103-5")
+RUN = CE.parent.parent
+MOUNT = Path("/users/bingzhuo/sandtable/build/mount/specula-redisraft")
+CONTAINER = "/root/sandtable/specula-redisraft"
+JAR = Path("/users/bingzhuo/sandtable/scripts/tla2tools.jar")
+SPEC = CE / "spec"
+SOURCE_FILES = (
+    "raft_log.c", "raft_server.c", "raft_node.c", "raft_server_properties.c",
+)
+CONFIGS = [
+    ("standard", "MC_for_sandtable.cfg", "MC_for_sandtable"),
+    ("crashrecovery", "MC_for_sandtable_crashrecovery.cfg", "MC_for_sandtable"),
+    ("membership", "MC_for_sandtable_membership.cfg", "MC_for_sandtable"),
+    ("snapshot", "MC_for_sandtable_snapshot.cfg", "MC_for_sandtable"),
+    ("staleread", "MC_for_sandtable_staleread.cfg", "MC_for_sandtable"),
+]
+BUGS = RUN / "potential-bugs" / "nextindex-self"
+
+
+def trace_name(seed):
+    return "t%04d" % seed
+
+
+def trace_dir(config, seed):
+    return CE / config / "traces" / trace_name(seed)
+
+
+def run(cmd, timeout=None, cwd=None):
+    return subprocess.run(
+        cmd, cwd=cwd, timeout=timeout, text=True,
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+    )
+
+
+def sync_working_copy():
+    MOUNT.mkdir(parents=True, exist_ok=True)
+    subprocess.run(
+        ["rsync", "-a", "--delete", str(CE / "system") + "/", str(MOUNT / "system") + "/"],
+        check=True,
+    )
+    subprocess.run(
+        ["rsync", "-a", "--delete", "--exclude", "driver/build", "--exclude", "__pycache__",
+         str(CE / "sandtable") + "/", str(MOUNT / "sandtable") + "/"],
+        check=True,
+    )
+    for script in (MOUNT / "sandtable").rglob("*.sh"):
+        script.chmod(0o755)
+
+
+def tlc_one(config, cfg, module, seed):
+    dest = trace_dir(config, seed)
+    dest.mkdir(parents=True, exist_ok=True)
+    out = dest / "MC.out"
+    if out.is_file() and "pc |->" in out.read_text(errors="replace"):
+        return config, seed, "cached"
+    meta = Path("/tmp") / ("tlc-rr-%s-%d" % (config, seed))
+    if meta.exists():
+        shutil.rmtree(meta, ignore_errors=True)
+    cmd = [
+        "java", "-Xmx2g", "-jar", str(JAR), "-tool", "-workers", "1", "-simulate",
+        "-depth", "50", "-seed", str(seed), "-metadir", str(meta),
+        "-config", cfg, module,
+    ]
+    try:
+        result = subprocess.run(
+            cmd, cwd=SPEC, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=180,
+        )
+    except subprocess.TimeoutExpired as exc:
+        out.write_text((exc.stdout or "") + "\n" + (exc.stderr or "") + "\nTIMEOUT\n")
+        (dest / "tlc.err").write_text(exc.stderr or "")
+        (dest / "tlc.status").write_text("124")
+        shutil.rmtree(meta, ignore_errors=True)
+        return config, seed, "timeout"
+    text = result.stdout if "@!" in result.stdout else result.stdout + "\n" + result.stderr
+    out.write_text(text)
+    (dest / "tlc.err").write_text(result.stderr)
+    (dest / "tlc.status").write_text(str(result.returncode))
+    shutil.rmtree(meta, ignore_errors=True)
+    if "pc |->" not in text:
+        return config, seed, "no-pc"
+    if "Invariant DepthBound is violated" in text:
+        return config, seed, "depth"
+    if "is violated" in text:
+        return config, seed, "safety"
+    return config, seed, "short"
+
+
+def sample(names, seeds, jobs):
+    tasks = []
+    for name, cfg, module in CONFIGS:
+        if name not in names:
+            continue
+        for seed in seeds:
+            tasks.append((name, cfg, module, seed))
+    print("sampling %d" % len(tasks), flush=True)
+    done = 0
+    bad = []
+    with ThreadPoolExecutor(max_workers=jobs) as pool:
+        futures = [pool.submit(tlc_one, *task) for task in tasks]
+        for fut in as_completed(futures):
+            config, seed, kind = fut.result()
+            done += 1
+            if kind not in ("cached", "depth", "safety"):
+                bad.append((config, seed, kind))
+                print("tlc %d/%d %s %s %s" % (done, len(tasks), config, trace_name(seed), kind), flush=True)
+            elif done == len(tasks) or done % 25 == 0:
+                print("tlc %d/%d %s %s %s" % (done, len(tasks), config, trace_name(seed), kind), flush=True)
+    return bad
+
+
+def clear_gcda():
+    for node in ("n1", "n2", "n3"):
+        run(["sudo", "docker", "exec", node, "bash", "-lc",
+             "rm -rf /tmp/gcov-%s /tmp/rr-persist-%s" % (node, node)])
+    run(["sudo", "docker", "exec", "controller", "bash", "-lc",
+         "find /root/sandtable/specula-redisraft/sandtable/systems/WRaft-series/driver/build -name '*.gcda' -delete"])
+
+
+def release_ports():
+    """Drop this round's leftover controller. Leave other sandtable runs alone."""
+    run(["sudo", "docker", "exec", "controller", "bash", "-lc",
+         "pkill -f specula-redisraft || true; sleep 0.2"])
+    for node in ("n1", "n2", "n3"):
+        run(["sudo", "docker", "exec", node, "bash", "-lc",
+             "pkill -f specula-redisraft || true"])
+    for _ in range(90):
+        other = run(["sudo", "docker", "exec", "controller", "bash", "-lc",
+                     "ps -eo args | grep -E '[r]un_one_testcase' || true"])
+        if "run_one_testcase.sh" not in (other.stdout or ""):
+            return
+        time.sleep(2)
+
+
+def replay_one(config, seed):
+    release_ports()
+    src = trace_dir(config, seed) / "MC.out"
+    host_work = MOUNT / "work" / config / trace_name(seed)
+    run(["sudo", "rm", "-rf", str(host_work)])
+    host_work.mkdir(parents=True)
+    shutil.copy(src, host_work / "MC.out")
+    container_mc = "%s/work/%s/%s/MC.out" % (CONTAINER, config, trace_name(seed))
+    script = CONTAINER + "/sandtable/systems/WRaft-series/RedisRaft/scripts/run_one_testcase.sh"
+    started = time.monotonic()
+    try:
+        result = run(["sudo", "docker", "exec", "controller", "bash", script, container_mc, "3"], timeout=180)
+        elapsed = time.monotonic() - started
+        code = result.returncode
+        extra = (result.stdout or "")[-2000:] + "\n" + (result.stderr or "")[-2000:]
+    except subprocess.TimeoutExpired as exc:
+        elapsed = time.monotonic() - started
+        code = 124
+        extra = "timeout\n" + str(exc)[-1000:]
+    log_host = next(host_work.rglob("log.host"), None)
+    traces = next(host_work.rglob("traces.txt"), None)
+    dest = trace_dir(config, seed)
+    if traces:
+        shutil.copy(traces, dest / "traces.txt")
+    if log_host:
+        shutil.copy(log_host, dest / "log.host")
+    (dest / "replay.status").write_text("exit %s\n%s\n" % (code, extra))
+    run(["sudo", "rm", "-rf", str(host_work)])
+    return elapsed, code
+
+
+def judge(config, seed, exit_code):
+    path = trace_dir(config, seed) / "log.host"
+    text = path.read_text(errors="replace") if path.is_file() else ""
+    variable = re.search(r'Variable "([^"]+)" compare failed', text)
+    logout = "logout" in text
+    sanitizer = "Sanitizer" in text or "stack smashing" in text
+    library_assert = "Assertion" in text and "compare failed" not in text[max(0, text.find("Assertion") - 400):text.find("Assertion") + 80]
+    # The controller asserts after a variable mismatch. That assert is not a library crash.
+    if variable and "Command::run_read_cmd" in text:
+        library_assert = False
+    died = "Segmentation fault" in text or "core dumped" in text or "Aborted" in text
+    if variable and "Command::run_read_cmd" in text:
+        died = False
+    traces = trace_dir(config, seed) / "traces.txt"
+    comments = []
+    if traces.is_file():
+        comments = [line for line in traces.read_text(errors="replace").splitlines() if line.startswith("# [")]
+    finished = bool(comments) and comments[-1] in text
+    code_value = model_value = pc = ""
+    if variable:
+        window = text[variable.start():variable.start() + 1200]
+        code_m = re.search(r"- Code \([^)]+\): (.*)", window)
+        model_m = re.search(r"- Model\([^)]+\): (.*)", window)
+        code_value = code_m.group(1).strip() if code_m else ""
+        model_value = model_m.group(1).strip() if model_m else ""
+        prior = list(re.finditer(r"# \[\d+\][^\n]*", text[:variable.start()]))
+        if prior:
+            pc = prior[-1].group(0).strip()
+    if not path.is_file():
+        kind, ok, detail = "crash", False, "no log.host"
+    elif "Address already in use" in text:
+        kind, ok, detail = "environment", False, "bind"
+    elif variable:
+        kind, ok, detail = "variable", False, variable.group(0)
+    elif sanitizer or library_assert or died or exit_code not in (0, None) or not logout or not finished:
+        kind, ok = "crash", False
+        if sanitizer:
+            detail = "sanitizer"
+        elif library_assert or died:
+            detail = "assert" if library_assert else "segfault"
+        elif not finished:
+            detail = "incomplete"
+        else:
+            detail = "exit %s" % exit_code
+    else:
+        kind, ok = "pass", True
+        detail = "net-len" if "Net mgs length compare failed" in text else ""
+    return {
+        "ok": ok, "logout": logout, "kind": kind, "variable": variable.group(1) if variable else "",
+        "code_value": code_value, "model_value": model_value, "detail": detail,
+        "netlen_warn": "Net mgs length compare failed" in text, "pc": pc,
+    }
+
+
+def collect_coverage(config, seed, elapsed, ok):
+    host_nodes = Path("/tmp/rr-gcov-nodes")
+    run(["sudo", "rm", "-rf", str(host_nodes)])
+    host_nodes.mkdir(parents=True)
+    for node in ("n1", "n2", "n3"):
+        run(["sudo", "docker", "cp", "%s:/tmp/gcov-%s" % (node, node), str(host_nodes / node)])
+        run(["sudo", "docker", "exec", "controller", "rm", "-rf", "/tmp/gcov-%s" % node])
+        run(["sudo", "docker", "cp", str(host_nodes / node), "controller:/tmp/gcov-%s" % node])
+    script = CONTAINER + "/sandtable/scripts/collect_gcov.sh"
+    result = run(["sudo", "docker", "exec", "controller", "bash", script], timeout=90)
+    out_dir = CE / config / "gcov"
+    if out_dir.exists():
+        run(["sudo", "rm", "-rf", str(out_dir)])
+    out_dir.mkdir(parents=True)
+    copied = run(["sudo", "docker", "cp", "controller:%s/gcov-out/." % CONTAINER, str(out_dir)])
+    run(["sudo", "chown", "-R", "%d:%d" % (os.getuid(), os.getgid()), str(out_dir)])
+    summary = (out_dir / "summary.txt").read_text(errors="replace") if (out_dir / "summary.txt").is_file() else ""
+    if result.returncode != 0 or copied.returncode != 0 or "Lines executed" not in summary:
+        raise SystemExit("gcov failed\n" + result.stdout + result.stderr + summary[-800:])
+    files = {}
+    current = None
+    for line in summary.splitlines():
+        named = re.match(r"File '(.+)'", line)
+        if named:
+            current = Path(named.group(1)).name
+            files[current] = {}
+            continue
+        match = re.search(r"([\d.]+)% of (\d+)", line)
+        if not current or not match:
+            continue
+        pct, total = float(match.group(1)), int(match.group(2))
+        if line.startswith("Lines executed:"):
+            files[current]["line_pct"] = pct
+            files[current]["lines"] = total
+        elif line.startswith("Taken at least once:"):
+            files[current]["branch_taken_pct"] = pct
+            files[current]["branches"] = total
+        elif line.startswith("Branches executed:"):
+            files[current]["branch_exec_pct"] = pct
+    library = [item for name, item in files.items() if name in SOURCE_FILES and "lines" in item]
+    line_total = sum(item["lines"] for item in library)
+    line_hit = sum(item["line_pct"] / 100.0 * item["lines"] for item in library)
+    branch_total = sum(item.get("branches", 0) for item in library)
+    branch_hit = sum(item.get("branch_taken_pct", 0) / 100.0 * item.get("branches", 0) for item in library)
+    entry = {
+        "trace": trace_name(seed),
+        "replay_s": round(elapsed, 3),
+        "ok": ok,
+        "line_pct": round(100.0 * line_hit / line_total, 2) if line_total else 0,
+        "branch_taken_pct": round(100.0 * branch_hit / branch_total, 2) if branch_total else 0,
+        "files": {name: files[name] for name in SOURCE_FILES if name in files},
+    }
+    path = CE / config / "coverage.json"
+    rows = json.loads(path.read_text()) if path.is_file() else []
+    rows = [row for row in rows if row["trace"] != entry["trace"]]
+    rows.append(entry)
+    rows.sort(key=lambda row: row["trace"])
+    path.write_text(json.dumps(rows, indent=2) + "\n")
+    run(["sudo", "rm", "-rf", str(host_nodes)])
+    return entry
+
+
+def failing_window(text):
+    marks = list(re.finditer(r"# \[\d+\]", text))
+    return text[marks[-1].start():] if marks else text
+
+
+def self_nextindex_only(verdict):
+    if verdict["variable"] != "nextIndex" or "BecomeLeader" not in verdict["pc"]:
+        return False
+    who = re.search(r"BecomeLeader (s\d)", verdict["pc"])
+    if not who:
+        return False
+    self_key = "n" + who.group(1)[1:]
+    try:
+        code = ast.literal_eval(verdict["code_value"])
+        model = ast.literal_eval(verdict["model_value"])
+    except (SyntaxError, ValueError):
+        return False
+    if not isinstance(code, dict) or not isinstance(model, dict):
+        return False
+    if set(code) != set(model):
+        return False
+    diffs = [key for key in code if code[key] != model[key]]
+    return diffs == [self_key] and code[self_key] == 1 and model[self_key] != 1
+
+
+def vote_response_higher_term(config, seed, verdict):
+    """Follower ignored a higher-term vote response in the formula, the library adopted it."""
+    if verdict["variable"] != "currentTerm":
+        return False
+    found = re.search(r"# \[(\d+)\] HandleRequestVoteResponse (s\d) (s\d) (\d+)", verdict["pc"])
+    if not found:
+        return False
+    step, receiver, source, seq = int(found.group(1)), found.group(2), found.group(3), int(found.group(4))
+    try:
+        code = int(verdict["code_value"])
+        model = int(verdict["model_value"])
+    except ValueError:
+        return False
+    if code <= model:
+        return False
+    text = (trace_dir(config, seed) / "MC.out").read_text(errors="replace")
+    blocks = re.split(r"(?m)^(\d+): <", text)
+    pre = None
+    for index in range(1, len(blocks) - 1, 2):
+        if int(blocks[index]) == step - 1:
+            pre = blocks[index + 1]
+            break
+    if pre is None:
+        return False
+    term_line = re.search(r"currentTerm = \(([^)]*)\)", pre)
+    state_line = re.search(r"state = \(([^)]*)\)", pre)
+    if not term_line or not state_line:
+        return False
+    terms = dict(re.findall(r"(s\d) :> (\d+)", term_line.group(1)))
+    states = dict(re.findall(r"(s\d) :> (\w+)", state_line.group(1)))
+    if terms.get(receiver) != str(model) or states.get(receiver) in ("", "Candidate"):
+        return False
+    for msg in re.finditer(r"\[([^\]]*)\]", pre):
+        body = msg.group(1)
+        if "RequestVoteResponse" not in body or not re.search(r"seq \|-> %d\b" % seq, body):
+            continue
+        term = re.search(r"mterm \|-> (\d+)", body)
+        src = re.search(r"msource \|-> (s\d)", body)
+        dst = re.search(r"mdest \|-> (s\d)", body)
+        if term and src and dst and int(term.group(1)) == code and src.group(1) == source and dst.group(1) == receiver:
+            return True
+    return False
+
+
+def label_failure(config, seed, verdict, text):
+    if verdict["detail"] == "bind" or "Address already in use" in text:
+        return "environment"
+    if verdict["kind"] == "variable":
+        window = failing_window(text)
+        broken = re.search(
+            r"deliver-unordered failed|was dropped|cannot find channel|Loop more than 40|"
+            r"out of boundary",
+            window,
+        )
+        if broken:
+            return "adapter"
+        if self_nextindex_only(verdict):
+            return "spec"
+        if vote_response_higher_term(config, seed, verdict):
+            return "spec"
+        return "unknown"
+    if verdict["detail"] in ("no log.host",) and "docker" in text.lower():
+        return "environment"
+    return "crash"
+
+
+def clear_failure(config, seed):
+    path = CE / "failures.tsv"
+    if not path.is_file():
+        return
+    row_key = "%s\t%s\t" % (config, trace_name(seed))
+    lines = [line for line in path.read_text().splitlines() if not line.startswith(row_key)]
+    path.write_text("\n".join(lines) + "\n")
+
+
+def record_failure(config, seed, exit_code, verdict, label):
+    path = CE / "failures.tsv"
+    if not path.is_file():
+        path.write_text("配置\t轨迹\t种子\t归类\t退出码\tlogout\t变量\t代码值\t模型值\tpc\t记录目录\n")
+    row_key = "%s\t%s\t" % (config, trace_name(seed))
+    kept = [line for line in path.read_text().splitlines() if not line.startswith(row_key)]
+    record = ""
+    if label in ("bug", "spec", "crash", "unknown"):
+        record = "potential-bugs/%s/%s-%s" % (bug_dir(config, seed, verdict, label), config, trace_name(seed))
+    kept.append("\t".join([
+        config, trace_name(seed), str(seed), label, str(exit_code),
+        "yes" if verdict["logout"] else "no", verdict["variable"], verdict["code_value"],
+        verdict["model_value"], verdict["pc"], record,
+    ]))
+    path.write_text("\n".join(kept) + "\n")
+    if label in ("bug", "spec", "crash", "unknown"):
+        copy_record(config, seed, verdict, label)
+
+
+def bug_dir(config, seed, verdict, label):
+    if label == "spec" and self_nextindex_only(verdict):
+        return "nextindex-self"
+    if label == "spec" and vote_response_higher_term(config, seed, verdict):
+        return "vote-response-term"
+    kind = "crash"
+    if verdict["pc"]:
+        parts = verdict["pc"].split()
+        kind = parts[2] if len(parts) > 2 else "step"
+    variable = verdict["variable"] or verdict["detail"] or "crash"
+    return re.sub(r"[^A-Za-z0-9_.-]+", "-", "%s-%s" % (variable, kind))[:80]
+
+
+def copy_record(config, seed, verdict, label):
+    src = trace_dir(config, seed)
+    name = bug_dir(config, seed, verdict, label)
+    dest = RUN / "potential-bugs" / name / ("%s-%s" % (config, trace_name(seed)))
+    dest.mkdir(parents=True, exist_ok=True)
+    for item in ("MC.out", "traces.txt", "log.host", "replay.status", "tlc.err", "tlc.status"):
+        if (src / item).is_file():
+            shutil.copy(src / item, dest / item)
+    if label == "spec" and name in ("nextindex-self", "vote-response-term"):
+        table = RUN / "potential-bugs" / name / "traces.tsv"
+        if not table.is_file():
+            table.write_text("配置\t轨迹\t种子\tpc\t代码值\t模型值\n")
+        row = "%s\t%s\t%s\t%s\t%s\t%s\n" % (
+            config, trace_name(seed), seed, verdict["pc"], verdict["code_value"], verdict["model_value"],
+        )
+        lines = table.read_text().splitlines()
+        key = "%s\t%s\t" % (config, trace_name(seed))
+        kept = [line for line in lines if not line.startswith(key)]
+        kept.append(row.rstrip("\n"))
+        table.write_text("\n".join(kept) + "\n")
+        return
+    note = dest.parent / "README.md"
+    if not note.is_file():
+        note.write_text("# %s\n\n归类 %s。细节见 failures.tsv 和这条轨迹的 log.host。\n" % (dest.parent.name, label))
+
+
+def fresh_config(name):
+    root = CE / name
+    if (root / "coverage.json").is_file():
+        (root / "coverage.json").unlink()
+    if (root / "gcov").is_dir():
+        shutil.rmtree(root / "gcov")
+    traces = root / "traces"
+    if traces.is_dir():
+        for path in traces.glob("t*/*"):
+            if path.name in ("log.host", "traces.txt", "replay.status"):
+                path.unlink()
+
+
+def already_done(config, seed):
+    dest = trace_dir(config, seed)
+    if not ((dest / "log.host").is_file() and (dest / "replay.status").is_file()):
+        return False
+    coverage = CE / config / "coverage.json"
+    if not coverage.is_file():
+        return False
+    rows = json.loads(coverage.read_text())
+    return any(row["trace"] == trace_name(seed) for row in rows)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--phase", default="replay", choices=["sample", "replay", "all"])
+    parser.add_argument("--configs", default="all")
+    parser.add_argument("--seeds", default="1-100")
+    parser.add_argument("--jobs", type=int, default=8)
+    parser.add_argument("--fresh", action="store_true")
+    args = parser.parse_args()
+    names = [item for item in args.configs.split(",") if item]
+    if names == ["all"]:
+        names = [item[0] for item in CONFIGS]
+    if "-" in args.seeds:
+        start, end = args.seeds.split("-")
+        seeds = list(range(int(start), int(end) + 1))
+    else:
+        seeds = [int(item) for item in args.seeds.split(",") if item]
+    if args.fresh:
+        failures = CE / "failures.tsv"
+        if failures.is_file():
+            failures.unlink()
+        for name in names:
+            fresh_config(name)
+    binary = MOUNT / "sandtable/systems/WRaft-series/driver/build/RedisRaftDriver"
+    if not binary.is_file():
+        raise SystemExit("RedisRaftDriver missing")
+    sync_working_copy()
+    print("binary kept", flush=True)
+    if args.phase in ("sample", "replay", "all"):
+        bad = sample(names, seeds, args.jobs)
+        if bad:
+            print("STOP sample %s" % bad[:8], flush=True)
+            return
+    if args.phase == "sample":
+        return
+    for name in names:
+        if not (CE / name / "coverage.json").is_file():
+            clear_gcda()
+        for seed in seeds:
+            if already_done(name, seed):
+                print("skip %s %s" % (name, trace_name(seed)), flush=True)
+                continue
+            if "pc |->" not in (trace_dir(name, seed) / "MC.out").read_text(errors="replace"):
+                print("STOP no-pc %s %s" % (name, trace_name(seed)), flush=True)
+                return
+            elapsed, code = replay_one(name, seed)
+            for _ in range(4):
+                host_log = trace_dir(name, seed) / "log.host"
+                if not (host_log.is_file() and "Address already in use" in host_log.read_text(errors="replace")):
+                    break
+                print("retry bind %s %s" % (name, trace_name(seed)), flush=True)
+                time.sleep(3)
+                elapsed, code = replay_one(name, seed)
+            verdict = judge(name, seed, code)
+            try:
+                entry = collect_coverage(name, seed, elapsed, verdict["ok"])
+                covered = "line %.2f" % entry["line_pct"]
+            except SystemExit as exc:
+                covered = "gcov-failed"
+                if not verdict["ok"]:
+                    text = (trace_dir(name, seed) / "log.host").read_text(errors="replace") if (trace_dir(name, seed) / "log.host").is_file() else ""
+                    label = label_failure(name, seed, verdict, text)
+                    record_failure(name, seed, code, verdict, label)
+                    print("FAIL %s %s %s %s %s gcov-failed" % (
+                        label, name, trace_name(seed), verdict["variable"] or verdict["detail"], verdict["pc"],
+                    ), flush=True)
+                print("STOP gcov %s %s %s" % (name, trace_name(seed), exc), flush=True)
+                return
+            if verdict["ok"]:
+                clear_failure(name, seed)
+                print("replay %s %s %.1fs pass %s" % (name, trace_name(seed), elapsed, covered), flush=True)
+                continue
+            text = (trace_dir(name, seed) / "log.host").read_text(errors="replace") if (trace_dir(name, seed) / "log.host").is_file() else ""
+            label = label_failure(name, seed, verdict, text)
+            record_failure(name, seed, code, verdict, label)
+            print("FAIL %s %s %s %s %s %s" % (
+                label, name, trace_name(seed), verdict["variable"] or verdict["detail"], verdict["pc"], covered,
+            ), flush=True)
+            if label in ("adapter", "spec", "crash", "unknown", "environment"):
+                print("STOP %s %s %s" % (label, name, trace_name(seed)), flush=True)
+                return
+    print("ROUND_DONE", flush=True)
+
+
+if __name__ == "__main__":
+    main()
