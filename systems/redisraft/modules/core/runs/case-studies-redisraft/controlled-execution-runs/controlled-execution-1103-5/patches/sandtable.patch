+struct Monitors {
+    int stale = 0;
+    int noop = 0;
+};
+
+Monitors read_monitors() {
+    Monitors m;
+    string path = shared_dir() + "/monitors";
+    FILE *fp = fopen(path.c_str(), "r");
+    if (!fp)
+        return m;
+    fscanf(fp, "%d %d", &m.stale, &m.noop);
+    fclose(fp);
+    return m;
+}
+
+void write_monitors(const Monitors &m) {
+    string dir = shared_dir();
+    mkdir(dir.c_str(), 0755);
+    string path = dir + "/monitors";
+    int fd = open(path.c_str(), O_RDWR | O_CREAT, 0644);
+    if (fd < 0)
+        return;
+    flock(fd, LOCK_EX);
+    ftruncate(fd, 0);
+    string body = to_string(m.stale) + " " + to_string(m.noop) + "\n";
+    if (write(fd, body.data(), body.size()) < 0) {
+        // The monitor file is the shared latch. A failed write leaves the old latch.
+    }
+    flock(fd, LOCK_UN);
+    close(fd);
+}
+
+bool has_current_term_committed() {
+    raft_server_t *me = me_of();
+    raft_log_t *log = static_cast<raft_log_t *>(raft_get_log(me));
+    long base = raft_log_get_base(log);
+    long count = raft_log_count(log);
+    long limit = me->commit_idx - base;
+    if (limit > count)
+        limit = count;
+    if (limit < 0)
+        limit = 0;
+    for (long k = 1; k <= limit; k++) {
+        raft_entry_t *ety = raft_log_get_at_idx(log, base + k);
+        if (ety && ety->term == me->current_term)
+            return true;
+    }
+    return false;
 }
 
