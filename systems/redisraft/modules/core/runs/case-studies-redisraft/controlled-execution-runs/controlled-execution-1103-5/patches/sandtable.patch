+string pack_entry(raft_entry_t *ety) {
+    string data;
+    int32_t data_len = ety->data_len;
+    int32_t type = ety->type;
+    raft_term_t term = ety->term;
+    raft_entry_id_t id = ety->id;
+    data.append((char *)&data_len, sizeof(data_len));
+    data.append((char *)&term, sizeof(term));
+    data.append((char *)&id, sizeof(id));
+    data.append((char *)&type, sizeof(type));
+    if (data_len)
+        data.append(ety->data, data_len);
+    return data;
+}
+
+raft_entry_t *unpack_entry(const char *&cursor, const char *end) {
+    int32_t data_len = 0, type = 0;
+    raft_term_t term = 0;
+    raft_entry_id_t id = 0;
+    auto take = [&](void *dst, size_t n) {
+        if (cursor + n > end)
+            return false;
+        memcpy(dst, cursor, n);
+        cursor += n;
+        return true;
+    };
+    if (!take(&data_len, sizeof(data_len)) || !take(&term, sizeof(term)) ||
+        !take(&id, sizeof(id)) || !take(&type, sizeof(type)))
+        return nullptr;
+    if (data_len < 0 || cursor + data_len > end)
+        return nullptr;
+    raft_entry_t *ety = raft_entry_new(data_len);
+    ety->term = term;
+    ety->id = id;
+    ety->type = type;
+    if (data_len)
+        memcpy(ety->data, cursor, data_len);
+    cursor += data_len;
+    return ety;
+}
+
+string pack_ae(raft_appendentries_req_t *msg) {
+    string data(sizeof(*msg), '\0');
+    memcpy(&data[0], msg, sizeof(*msg));
+    for (long i = 0; i < msg->n_entries; i++)
+        data += pack_entry(msg->entries[i]);
+    return data;
+}
+
+raft_appendentries_req_t *unpack_ae(const string &payload) {
+    if (payload.size() < sizeof(raft_appendentries_req_t))
+        return nullptr;
+    auto *msg = static_cast<raft_appendentries_req_t *>(raft_calloc(1, sizeof(raft_appendentries_req_t)));
+    memcpy(msg, payload.data(), sizeof(*msg));
+    msg->entries = static_cast<raft_entry_t **>(raft_calloc(msg->n_entries ? msg->n_entries : 1, sizeof(raft_entry_t *)));
+    const char *cursor = payload.data() + sizeof(*msg);
+    const char *end = payload.data() + payload.size();
+    for (long i = 0; i < msg->n_entries; i++) {
+        msg->entries[i] = unpack_entry(cursor, end);
+        if (!msg->entries[i]) {
+            raft_entry_release_list(msg->entries, i);
+            raft_free(msg);
+            return nullptr;
+        }
+    }
+    return msg;
+}
+
+int send_appendentries(raft_server_t *, void *, raft_node_t *node, raft_appendentries_req_t *msg) {
+    return emit(raft_node_get_id(node), pack_ae(msg), MSG_AE);
+}
