--- a/scripts/collect_gcov.sh
+++ b/scripts/collect_gcov.sh
@@ -0,0 +1,24 @@
+#!/bin/bash
+# Merge the three nodes' gcda inside the controller and emit gcov for the library.
+set -euo pipefail
+BASE=/root/sandtable/specula-wraft/sandtable/systems/WRaft-series/driver/build/CMakeFiles/WRaftDriver.dir
+SRC=root/sandtable/specula-wraft/system/src
+OUT=/root/sandtable/specula-wraft/gcov-out
+rm -rf /tmp/wraft-gcov-a /tmp/wraft-gcov "$OUT"
+mkdir -p "$OUT"
+gcov-tool merge -o /tmp/wraft-gcov-a /tmp/gcov-n1 /tmp/gcov-n2
+gcov-tool merge -o /tmp/wraft-gcov /tmp/wraft-gcov-a /tmp/gcov-n3
+cd "$OUT"
+shopt -s nullglob
+found=0
+for g in "$BASE/$SRC"/*.gcno; do
+    name=$(basename "$g" .gcno)
+    cp "/tmp/wraft-gcov/$BASE/$SRC/$name.gcda" .
+    cp "$g" .
+    found=1
+done
+if [[ "$found" -ne 1 ]]; then
+    echo "no library gcno" >&2
+    exit 1
+fi
+gcov -b ./*.gcno > "$OUT/summary.txt"
