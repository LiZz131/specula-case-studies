+}
+
+static string fmt_index(const map<string, int> &values) {
+    string text = "{";
+    bool first = true;
+    for (const auto &item : values) {
+        if (!first) text += ", ";
+        first = false;
+        text += "'" + item.first + "': " + to_string(item.second);
+    }
+    text += "}";
+    return text;
+}
+
+static string fmt_log(const vector<DiskEntry> &entries) {
+    string text = "[";
+    for (size_t i = 0; i < entries.size(); i++) {
+        if (i) text += ", ";
+        text += "(" + to_string(entries[i].term) + ", '" + entries[i].value + "')";
+    }
+    text += "]";
+    return text;
