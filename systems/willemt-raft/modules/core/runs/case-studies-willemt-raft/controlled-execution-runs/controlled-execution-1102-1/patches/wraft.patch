+static bool rebuild_from_copy() {
+    disk = Disk();
+    disk = read_persist();
+    replaying = true;
+    raft_server_t *me = raft_new();
+    if (!me) {
+        replaying = false;
+        return false;
+    }
+    raft_set_callbacks(me, &raft_cbs, nullptr);
+    auto *priv = reinterpret_cast<raft_server_private_t *>(me);
+    if (disk.snap_idx > 0) {
+        log_load_from_snapshot(static_cast<log_t *>(priv->log), disk.snap_idx, disk.snap_term);
+        priv->snapshot_last_idx = disk.snap_idx;
+        priv->snapshot_last_term = disk.snap_term;
+    }
+    for (const auto &saved : disk.log) {
+        raft_entry_t *entry = static_cast<raft_entry_t *>(calloc(1, sizeof(raft_entry_t)));
+        entry->term = saved.term;
+        entry->type = RAFT_LOGTYPE_NORMAL;
+        string bytes = saved.value;
+        if (bytes.size() >= sizeof(void *)) bytes.resize(sizeof(void *) - 1);
+        memcpy(&entry->data.buf, bytes.c_str(), bytes.size());
+        int err = raft_append_entry(me, entry);
+        free(entry);
+        if (err != 0) {
+            replaying = false;
+            raft_free(me);
+            return false;
+        }
+    }
+    add_configured_nodes(me);
+    priv->current_term = disk.term;
+    priv->voted_for = disk.vote;
+    for (int i = 0; i < priv->num_nodes; i++) {
+        auto *node = reinterpret_cast<raft_node_t *>(priv->nodes[i]);
+        string name = node_name(raft_node_get_id(node));
+        if (disk.next_idx.count(name))
+            raft_node_set_next_idx(node, disk.next_idx[name]);
+        if (disk.match_idx.count(name))
+            raft_node_set_match_idx(node, disk.match_idx[name]);
+        bool voted = find(disk.votes.begin(), disk.votes.end(), name) != disk.votes.end();
+        raft_node_vote_for_me(node, voted ? 1 : 0);
+    }
+    priv->state = RAFT_STATE_FOLLOWER;
+    priv->commit_idx = 0;
+    priv->last_applied_idx = 0;
+    priv->current_leader = nullptr;
+    priv->timeout_elapsed = 0;
+    replaying = false;
+    config.set_raft_server(me);
+    server_down = false;
+    freeze_vars.clear();
+    unlink(freeze_path().c_str());
+    return true;
+}
