+static string live_log(raft_server_private_t *me) {
+    auto base = log_get_base(static_cast<log_t *>(me->log));
+    vector<DiskEntry> entries;
+    for (int i = 1; true; i++) {
+        raft_entry_t *entry = log_get_at_idx(static_cast<log_t *>(me->log), i + base);
+        if (!entry) break;
+        entries.push_back(DiskEntry{static_cast<int>(entry->term), entry_text(entry)});
+    }
+    return fmt_log(entries);
+}
+
+static map<string, int> live_index(raft_server_private_t *me, bool next_index) {
+    map<string, int> values;
+    for (int i = 0; i < me->num_nodes; i++) {
+        auto *node = reinterpret_cast<raft_node_t *>(me->nodes[i]);
+        string name = node_name(raft_node_get_id(node));
+        values[name] = static_cast<int>(next_index ? raft_node_get_next_idx(node)
+                                                    : raft_node_get_match_idx(node));
+    }
+    return values;
+}
+
+static vector<string> live_votes(raft_server_private_t *me) {
+    vector<string> names;
+    for (int i = 0; i < me->num_nodes; i++) {
+        auto *node = reinterpret_cast<raft_node_t *>(me->nodes[i]);
+        if (raft_node_has_vote_for_me(node))
+            names.push_back(node_name(raft_node_get_id(node)));
+    }
+    sort(names.begin(), names.end());
+    return names;
+}
+
+static void write_freeze_file() {
+    ostringstream out;
+    for (const auto &item : freeze_vars)
+        out << item.first << "=" << item.second << "\n";
+    write_bytes(freeze_path(), out.str());
+}
+
+static void load_freeze_file() {
+    freeze_vars.clear();
+    ifstream in(freeze_path());
+    string line;
+    while (getline(in, line)) {
+        auto pos = line.find('=');
+        if (pos == string::npos) continue;
+        freeze_vars[line.substr(0, pos)] = line.substr(pos + 1);
+    }
+}
+
+static void take_freeze() {
+    auto *me = server_private();
+    freeze_vars.clear();
+    if (!me) return;
+    freeze_vars["commitIndex"] = to_string(me->commit_idx);
+    freeze_vars["currentTerm"] = to_string(me->current_term);
+    freeze_vars["log"] = live_log(me);
+    freeze_vars["state"] = to_string(me->state);
+    freeze_vars["lastApplied"] = to_string(me->last_applied_idx);
+    freeze_vars["votedFor"] = node_name(me->voted_for);
+    freeze_vars["votesGranted"] = fmt_votes(live_votes(me));
+    freeze_vars["snapshotLastIdx"] = to_string(me->snapshot_last_idx);
+    freeze_vars["snapshotLastTerm"] = to_string(me->snapshot_last_term);
+    freeze_vars["nextIndex"] = fmt_index(live_index(me, true));
+    freeze_vars["matchIndex"] = fmt_index(live_index(me, false));
+    freeze_vars["crashed"] = "TRUE";
+    write_freeze_file();
+}
+
+static bool RaftCrash() {
+    if (server_down || !config.get_raft_server()) return false;
+    sync_retained();
+    take_freeze();
+    raft_free(static_cast<raft_server_t *>(config.get_raft_server()));
+    config.set_raft_server(nullptr);
+    server_down = true;
+    cerr << "PERSIST term=" << disk.term << " vote=" << disk.vote
+         << " snap=" << disk.snap_idx << ":" << disk.snap_term
+         << " log=" << fmt_log(disk.log) << endl;
+    return true;
+}
