+        yield ["wait-init", "3"]
+        for impl in ("n1", "n2", "n3"):
+            yield ["loop", "execute", impl, "net isallconnected"]
+        return
+    if kind == "Timeout":
+        impl = node(pc[1])
+        yield ["intercept", impl, "inc_time_ms", "2000"]
+        yield ["execute", impl, "raft periodic 2000"]
+        return
+    if kind == "HandleRequestVoteRequest":
+        yield ["execute", node(pc[1]), "raft vote-mode " + pc[4]]
