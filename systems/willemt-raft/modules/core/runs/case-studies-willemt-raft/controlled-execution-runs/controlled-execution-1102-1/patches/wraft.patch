+def node(name):
+    if name not in NODES:
+        raise SystemExit("unknown server %s" % name)
+    return NODES[name]
+
+
+def ordered(names):
+    return [item for item in ORDER if item in set(names)]
+
+
+def text_of(value):
+    if isinstance(value, (list, tuple, set, frozenset)):
+        return ",".join(text_of(item) for item in value)
+    return str(value)
+
+
+def fmt_log(entries):
+    parts = ["(%s, '%s')" % (entry["term"], entry["value"]) for entry in entries]
+    return "[" + ", ".join(parts) + "]"
+
+
+def fmt_votes(names):
+    return "{" + ",".join(node(name) for name in sorted(names)) + "}"
+
+
+def fmt_index(values):
+    parts = ["'%s': %s" % (node(name), values[name]) for name in sorted(values)]
+    return "{" + ", ".join(parts) + "}"
+
+
+def model_value(name, value):
+    if name == "log":
+        return fmt_log(value)
+    if name == "state":
+        return STATE[value]
+    if name == "votedFor":
+        return "Nil" if value == "Nil" else node(value)
+    if name == "votesGranted":
+        return fmt_votes(value)
+    if name in ("nextIndex", "matchIndex"):
+        return fmt_index(value)
+    if name == "crashed":
+        return "TRUE" if value else "FALSE"
