+class SeqMap:
+    """The controller moves a capture out of its array on deliver, so one seq
+    can be written only once. duplicate-unordered allocates a new capture and
+    shifts every later index. Each formula seq keeps a list of controller
+    indexes still in the bag: the original, then one new index per copy.
+    """
+
+    def __init__(self):
+        self.offset = 0
+        self.slots = {}
+
+    def note_sends(self, before, after):
+        for seq in range(before + 1, after + 1):
+            self.slots[seq] = [seq + self.offset]
+
+    def take(self, seq):
+        slots = self.slots.get(seq) or []
+        if not slots:
+            raise SystemExit("seq %s has no copy left" % (seq,))
+        return slots.pop(0)
+
+    def on_duplicate(self, seq, n_sent):
+        slots = self.slots.get(seq) or []
+        if not slots:
+            raise SystemExit("seq %s is not in the bag" % (seq,))
+        new_ctrl = n_sent + self.offset + 1
+        slots.append(new_ctrl)
+        self.offset += 1
+        return slots[-2]
+
+    def on_lose(self, seq):
+        slots = self.slots.get(seq) or []
+        if not slots:
+            raise SystemExit("seq %s has no copy left" % (seq,))
+        return slots.pop()
+
