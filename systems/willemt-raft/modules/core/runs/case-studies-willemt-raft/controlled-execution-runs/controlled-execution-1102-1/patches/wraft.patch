+static void sync_retained() {
+    auto *me = server_private();
+    if (!me || server_down) return;
+    disk.snap_idx = static_cast<int>(me->snapshot_last_idx);
+    disk.snap_term = static_cast<int>(me->snapshot_last_term);
+    disk.next_idx.clear();
+    disk.match_idx.clear();
+    disk.votes.clear();
+    for (int i = 0; i < me->num_nodes; i++) {
+        auto *node = reinterpret_cast<raft_node_t *>(me->nodes[i]);
+        string name = node_name(raft_node_get_id(node));
+        disk.next_idx[name] = static_cast<int>(raft_node_get_next_idx(node));
+        disk.match_idx[name] = static_cast<int>(raft_node_get_match_idx(node));
+        if (raft_node_has_vote_for_me(node)) disk.votes.push_back(name);
+    }
+    sort(disk.votes.begin(), disk.votes.end());
+    write_persist();
+}
