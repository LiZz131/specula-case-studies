+static void write_bytes(const string &path, const string &body) {
+    string tmp = path + ".tmp";
+    int fd = open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd < 0) return;
+    const char *p = body.data();
+    size_t left = body.size();
+    while (left) {
+        ssize_t n = write(fd, p, left);
+        if (n <= 0) break;
+        p += n;
+        left -= n;
+    }
+    fsync(fd);
+    close(fd);
+    rename(tmp.c_str(), path.c_str());
+}
+
+static string serialize_disk() {
+    ostringstream out;
+    out << "TERM " << disk.term << "\n";
+    out << "VOTE " << disk.vote << "\n";
+    out << "SNAP " << disk.snap_idx << " " << disk.snap_term << "\n";
+    out << "LOG " << disk.log.size() << "\n";
+    for (const auto &entry : disk.log)
+        out << entry.term << " " << entry.value << "\n";
+    out << "NEXT " << disk.next_idx.size() << "\n";
+    for (const auto &item : disk.next_idx)
+        out << item.first << " " << item.second << "\n";
+    out << "MATCH " << disk.match_idx.size() << "\n";
+    for (const auto &item : disk.match_idx)
+        out << item.first << " " << item.second << "\n";
+    out << "VOTES " << disk.votes.size() << "\n";
+    for (const auto &name : disk.votes)
+        out << name << "\n";
+    return out.str();
+}
+
+static void write_persist() {
+    write_bytes(persist_path(), serialize_disk());
+}
+
+static Disk read_persist() {
+    Disk loaded;
+    ifstream in(persist_path());
+    if (!in) return loaded;
+    string tag;
+    in >> tag >> loaded.term;
+    in >> tag >> loaded.vote;
+    in >> tag >> loaded.snap_idx >> loaded.snap_term;
+    size_t count = 0;
+    in >> tag >> count;
+    for (size_t i = 0; i < count; i++) {
+        DiskEntry entry;
+        in >> entry.term >> entry.value;
+        loaded.log.push_back(entry);
+    }
+    in >> tag >> count;
+    for (size_t i = 0; i < count; i++) {
+        string name;
+        int value = 0;
+        in >> name >> value;
+        loaded.next_idx[name] = value;
+    }
+    in >> tag >> count;
+    for (size_t i = 0; i < count; i++) {
+        string name;
+        int value = 0;
+        in >> name >> value;
+        loaded.match_idx[name] = value;
+    }
+    in >> tag >> count;
+    for (size_t i = 0; i < count; i++) {
+        string name;
+        in >> name;
+        loaded.votes.push_back(name);
+    }
+    return loaded;
+}
